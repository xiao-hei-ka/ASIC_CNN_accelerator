# =========================================================================
# Xilinx Vivado & FPGA 相关 (适用于 rtl/, scripts/, 和工程根目录)
# =========================================================================
# 日志和历史记录文件
*.jou
*.log
*.pb
*.str
*.backup.*
*.debug

# Vivado 工程生成的庞大目录 (建议通过 TCL 脚本重建工程，而不是提交这些)
.Xil/
*.cache/
*.hw/
*.ip_user_files/
*.runs/
*.sim/
*.srcs/
# 如果你坚持要提交 .xpr 文件，注释掉下面这行；如果是完全脚本化流程，请保留
*.xpr 

# Vivado HLS / Vitis HLS (如果你的 IP 涉及 HLS)
*prj/
*.aps

# =========================================================================
# 仿真与测试平台 (适用于 tb/)
# =========================================================================
# 仿真波形与数据库文件
*.vcd
*.wdb
*.fsdb
*.shm/
*.vpd
xsim.dir/
xelab.pb
webtalk*.xml

# =========================================================================
# 软件开发与 Vitis 环境 (适用于 sw/)
# =========================================================================
# 编译生成的中间文件和可执行文件
*.o
*.a
*.so
*.elf
*.bin
*.out
*.exe
.ide/
.metadata/
RemoteSystemsTempFiles/
build/
CMakeCache.txt
CMakeFiles/

# =========================================================================
# 深度学习模型与数据 (适用于 models/)
# =========================================================================
# 庞大的数据集 (比如 MNIST 的 raw 压缩包解压目录)
data/
dataset/

# 训练过程中的中间权重和检查点 (按需保留最终的 baseline 权重)
*.ckpt
*checkpoint*/
*.pth.tar

# Vitis AI 编译生成的中间产物
*.xmodel
*quantize_result/
*compile_result/

# =========================================================================
# Python 脚本环境 (适用于 scripts/ 和 models/)
# =========================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env/
pip-log.txt
.ipynb_checkpoints/

# =========================================================================
# 操作系统与编辑器相关的临时文件 (通用)
# =========================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
*.bak

# =========================================================================
# 文档生成的临时文件 (适用于 doc/)
# =========================================================================
~$*.docx
~$*.xlsx
*.tmp

# 模型文件目录
models/